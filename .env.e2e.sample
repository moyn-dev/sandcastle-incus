# Sample environment for the sc2 end-to-end protocol (docs/e2e-sc2.md).
# Copy to .env.sc2 at the repo root and fill in the values. .env.sc2 is
# gitignored; this sample is tracked. scripts/e2e.sh sources it with `set -a`.

# --- Core prerequisites --------------------------------------------------
# Public hostname of the Auth App under test (the harness's existing spelling).
PUBIC_URL=sc2.example.dev
# REUSABLE, pre-authorized Tailscale auth key, allowed to carry tag:sandcastle. Both the
# e2e client and the tenant sidecar join with it; a single-use key is consumed by the
# first and the sidecar's join then fails with "invalid key: API key … not valid".
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: real GitHub OAuth app (omit for the simulated login path) --
# Callback URL is https://<auth-host>/oauth/github/callback
#GH_CLIENT_ID=
#GH_CLIENT_SECRET=

# --- Optional: harness-side route approval scripting ---------------------
#TAILSCALE_API_KEY=

# --- Phase 12: Public DNS Zones (ADR-0027) -------------------------------
# Both are required for the phase to run; absent → Phase 12 is SKIPPED, not failed.
# The install under test must be deployed with
#   --acme-directory https://acme-staging-v02.api.letsencrypt.org/directory
# so only Let's Encrypt staging is used. The zone must be a Cloudflare zone
# (or a name inside one) that the token can edit; records land under
# e2e-<run>.<zone> and are removed on cleanup.
SANDCASTLE_E2E_PUBLIC_DNS_ZONE=hosted.example.dev
# Cloudflare API token with Zone:Read + DNS:Edit on the zone above, nothing else.
SANDCASTLE_E2E_CLOUDFLARE_TOKEN=cf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Phase 12 tuning (defaults are fine) --------------------------------
#SANDCASTLE_E2E_PDZ_DNS_TIMEOUT=180     # seconds to wait for the A record
#SANDCASTLE_E2E_PDZ_CERT_TIMEOUT=600    # seconds to wait for the certificate
#SANDCASTLE_E2E_PDZ_RESOLVER=1.1.1.1    # public resolver for the A-record check
#SANDCASTLE_E2E_PDZ_KEEP=1              # leave zone/project/machine for inspection

# Note: the live phases also need SANDCASTLE_E2E=1 on the command line:
#   SANDCASTLE_E2E=1 scripts/e2e.sh pdz
